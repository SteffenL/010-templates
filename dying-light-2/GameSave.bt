typedef struct {
    uint16 length;
    if (length > 0) {
        char data[length] <optimize=false>;
    }
} string_t <read=read_string_t>;

string read_string_t(string_t& s) {
    local string result = "";
    if (s.length > 0) {
        Strncpy(result, s.data, s.length);
     }
    //return s.length > 0 ? s.data : "";
    return result;
};

typedef struct {
    string_t key;
    uint16 value;
} uint16_dictionary_entry_t <read=read_uint16_dictionary_entry_t>;

string read_uint16_dictionary_entry_t(uint16_dictionary_entry_t& entry) {
    return read_string_t(entry.key);
};

struct uint16_dictionary_t {
    uint32 length;
    if (length > 0) {
        uint16_dictionary_entry_t entries[length] <optimize=false>;
    }
};

typedef uint64 rtt_pointer_t;

struct string_vector_t {
    uint32 length;
    if (length > 0) {
        string_t elements[length] <optimize=false>;
    }
};

struct byte_vector_t {
    uint32 length;
    if (length > 0) {
        byte elements[length] <optimize=false>;
    }
};

struct int16_vector_t {
    uint32 length;
    if (length > 0) {
        int16 elements[length] <optimize=false>;
    }
};

struct int32_vector_t {
    uint32 length;
    if (length > 0) {
        int32 elements[length] <optimize=false>;
    }
};

struct uint64_vector_t {
    uint32 length;
    if (length > 0) {
        uint64 elements[length] <optimize=false>;
    }
};

struct pointer_vector_t {
    uint32 length;
    if (length > 0) {
        rtt_pointer_t elements[length] <optimize=false>;
    }
};

struct data_chunk_header_t {
    int32 magic;
    int32 b;
    int32 size;
};


struct blob_header_t {
    uint32 size;
    local uint64 offset = FTell();
};

struct blob_t {
    uint32 length;
    if (length > 0) {
        byte data[length] <optimize=false>;
    }
};

enum rtti_data_type_t {
    RTTI_DATA_TYPE_INT8 = 2, // Skills::SkillInstance::{m_SkillSlot}
    RTTI_DATA_TYPE_INT16 = 3, // signed, Savegame::GameTypeInfo::{m_CityAlignemntPK, m_CityAlignemntSurv}
    RTTI_DATA_TYPE_INT32 = 5, // signed
    RTTI_DATA_TYPE_UINT32 = 6, // unsigned, Story::Savegame::Info{m_Chapter, m_Crc}
    RTTI_DATA_TYPE_UINT64 = 7, // likely - Savegame::GameTypeInfo::{m_TimePlayed, m_PlaythroughStartTime}, Story::Savegame::Info::{m_QuestId, m_QuestCampaignId}, Story::Savegame::CampaignRewards::{m_CampaignId}
    RTTI_DATA_TYPE_U008 = 8, // maybe uint32 - Savegame::StoryAgentsState::Agent::{m_Points, m_Hash}, Savegame::Looting::ContainerId::{m_Guid}
    RTTI_DATA_TYPE_FLOAT = 9, // Savegame::GameTypeInfo::{m_AbsoluteTime}
    RTTI_DATA_TYPE_BOOL = 11, // Savegame::GameTypeInfo::{m_MultiplayerBlockade, m_Played, m_CampaignFinished, m_LegendLevelUnlocked}
    RTTI_DATA_TYPE_STRING = 12, // Savegame::GameTypeInfo::{m_CharacterPreset}
    RTTI_DATA_TYPE_VECTOR3 = 14, // likely
    RTTI_DATA_TYPE_INT32_STRING_PAIR = 20, // Savegame::SpawnSpot::m_SpotType, Savegame::GameTypeInfo::{m_GameType, m_Difficulty}, Savegame::GameInfo::{m_LastPlayedGameType}
    RTTI_DATA_TYPE_VECTOR_OF_UINT64_25 = 25, // Savegame::GameInfo::{m_EmbeddedElements}
    RTTI_DATA_TYPE_VECTOR_OF_STRING = 30, // Savegame::GameTypeInfo::m_PlayerOutfitParts
    RTTI_DATA_TYPE_U0039 = 39, // Story::Savegame::Info::{m_Campaigns, m_Objectives}, Savegame::PersistentStorage::CampaignState::{m_DataDescription, m_Data, m_DataPresence, }
    RTTI_DATA_TYPE_VECTOR_OF_BYTE = 40, // Savegame::ServerAchievement::State::{m_Data}
    RTTI_DATA_TYPE_VECTOR_OF_INT16 = 41, // Savegame::ProgressionState::{m_LegendRewardReceivedUids}
    RTTI_DATA_TYPE_VECTOR_OF_INT32 = 43, // Savegame::GameTypeInfo::{m_PlayerLevel}
    RTTI_DATA_TYPE_U0044 = 44, // Savegame::Looting::ContainerId::{m_CPath}, Savegame::Roaming::FovMapTiles::{m_Data}
    RTTI_DATA_TYPE_VECTOR_OF_POINTER = 56, // Savegame::GameTypeInfoContainer::{m_Data}
    RTTI_DATA_TYPE_VECTOR_OF_UINT64 = 57, // likely - Story::Savegame::Info::{m_Campaigns}, Story::Savegame::CampaignRewards::{m_OwnersUid}, Savegame::ProgressionState::{m_QuestRewardsWithLegend}
    RTTI_DATA_TYPE_VECTOR_OF_U0059 = 59, // Savegame::Difficulty::Trigger::{m_EventInstances}
    RTTI_DATA_TYPE_U0061 = 61, // class Savegame::Challenges::Challenge::{m_TriggersData}
    RTTI_DATA_TYPE_POINTER = 85, // Savegame::GameTypeInfo::{m_StoryInfo, m_SpawnSpot, m_LastPlayDateTime}
    RTTI_DATA_TYPE_VECTOR_OF_POINTER_86 = 86, // Savegame::GameTypeInfo::{m_Versions}, Savegame::GameInfo::{m_SaveVersion, m_Backup, m_DataContainer}
};

struct rtti_field_t {
    string_t name;
    int16 type;
};

string read_rtti_field_t(rtti_field_t& field) {
    return read_string_t(field.name);
};

struct rtti_fields_t {
    int32 count;
    rtti_field_t fields[count] <optimize=false, read=read_rtti_field_t>;
};

struct rtti_info_t {
    uint64 index;
    int32 likely_version;
    string_t class_name;
    rtti_fields_t fields;
};

struct vector3_t {
    float x, y, z;
};

struct element_blob_header_t {
    int32 a;
    int32 size;
    local uint64 offset = FTell();
};

struct int32_string_pair_t {
    int32 first;
    string_t second;
};

