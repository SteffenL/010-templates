//------------------------------------------------

typedef struct {
    uint16 length;
    if (length > 0) {
        char data[length];
    }
} string_t <read=read_string_t>;

string read_string_t(string_t& s) {
    return s.length > 0 ? s.data : "";
};

typedef struct {
    string_t key;
    uint16 value;
} uint16_dictionary_entry_t <read=read_uint16_dictionary_entry_t>;

string read_uint16_dictionary_entry_t(uint16_dictionary_entry_t& entry) {
    return read_string_t(entry.key);
};

struct uint16_dictionary_t {
    uint32 length;
    if (length > 0) {
        uint16_dictionary_entry_t entries[length] <optimize=false>;
    }
};

struct string_vector_t {
    uint32 length;
    if (length > 0) {
        string_t elements[length] <optimize=false>;
    }
};

struct byte_vector_t {
    uint32 length;
    if (length > 0) {
        byte elements[length];
    }
};

struct data_chunk_header_t {
    int32 magic;
    int32 b;
    int32 size;
};


struct blob_header_t {
    uint32 size;
    local uint64 offset = FTell();
};

struct blob_t {
    uint32 length;
    if (length > 0) {
        byte data[length];
    }
};

struct rtti_field_t {
    string_t name;
    int16 type;
};

string read_rtti_field_t(rtti_field_t& field) {
    return read_string_t(field.name);
};

struct rtti_fields_t {
    int32 count;
    rtti_field_t fields[count] <optimize=false, read=read_rtti_field_t>;
};

struct rtti_info_t {
    int64 index;
    int32 b;
    string_t class_name;
    rtti_fields_t fields;
};

struct vector3_t {
    float x, y, z;
};

struct element_blob_header_t {
    int32 a;
    int32 size;
    local uint64 offset = FTell();
};

enum element_type_t {
    ET_CLASS = 1
};

typedef uint64 rtt_pointer_t;

struct class_element_t {
    int32 a; // version?
    string_t class_name;
    int32 b;

    struct {
        blob_header_t blob_header;
        byte a;

        struct {
            blob_header_t blob_header;
        
            data_chunk_header_t rtti_data_chunk_header;
            Assert(rtti_data_chunk_header.magic == 0x44444753); // SGDD
            struct {
                local uint32 count = 0;
                local uint64 start = FTell();
                while (FTell() < start + rtti_data_chunk_header.size) {
                    data_chunk_header_t header;
                    Assert(header.magic == 0x64444753); // SGDd
                    rtti_info_t rtti_info;
                    ++count;
                }

                local int32 table[count];
                local uint32 i;
                for (i = 0; i < count; ++i) {
                    table[rtti_info[i].index] = i;
                }
            } rtti_data_chunk_data;

            data_chunk_header_t chunk2_header;
            Assert(chunk2_header.magic == 0x6D474453); // SDGm
            uint64 data_chunk2_data;
        
            data_chunk_header_t chunk3_header;
            Assert(chunk3_header.magic == 0x53444753); // SGDS
            struct {
                local uint64 end = FTell() + chunk3_header.size;
                while (FTell() < end) {
                    struct {
                        data_chunk_header_t header;
                        Assert(header.magic == 0x73444753);
                        rtt_pointer_t id;
                        uint64 rtti_info_index;
                        local int32 rtti_info_array_index = rtti_data_chunk_data.table[rtti_info_index];

                        switch (rtti_info_index) {
                            case 0:
                                struct { // Savegame::GameInfo
                                    rtt_pointer_t m_SaveVersion;
                                    rtt_pointer_t m_DataContainer;
                                    struct {
                                        int32 a;
                                        string_t b;
                                    } m_LastPlayedGameType;
                                    int32 m_EmbeddedElements;
                                    int32 m_GameType;
                                    int32 m_MapId;
                                } Savegame__GameInfo;
                                break;

                            case 1:
                                struct { // Savegame::GameTypeInfoContainer
                                    // m_Data
                                    int32 a;
                                    int64 b;
                                } Savegame__GameTypeInfoContainer;
                                break;

                            case 2:
                                struct { // Savegame::GameTypeInfo
                                    int32 c;
                                    uint32 m_GameSessionId;
                                    string_t m_GameType;
                                    byte m_MultiplayerBlockade;
                                    rtt_pointer_t m_StoryInfo;
                                    struct {
                                        int32 a;
                                        string_t b;
                                    } m_Difficulty;
                                    struct {
                                        int32 a;
                                        string_t b;
                                    } m_MinDifficulty;
                                    //byte m_CampaignFinished; // game v1.04
                                    struct {
                                        int32 a;
                                        string_t b;
                                    } m_FinishedDifficulty;
                                    rtt_pointer_t m_SpawnSpot;
                                    struct {
                                        int32 length;
                                        int32 elements[length];
                                    } m_PlayerLevel;
                                    int32 m_PlayerProgress;
                                    string_t m_CharacterPreset;
                                    int32 m_PlayerAppearanceId;
                                    string_vector_t m_PlayerOutfitParts;
                                    byte m_Played;
                                    int64 m_TimePlayed;
                                    rtt_pointer_t m_LastPlayDateTime;
                                    int32 m_AbsoluteTime;
                                    byte m_CampaignFinished; // game v1.03
                                    int32 m_GamePlus;
                                    int16 m_CityAlignemntPK; // PK = Pacekeeper?
                                    int16 m_CityAlignemntSurv; // Suv = Survivor?
                                    rtt_pointer_t m_FirstVersion;
                                    rtt_pointer_t m_Version;
                                } Savegame__GameTypeInfo;
                                break;

                            case 3:
                                struct { // Savegame::VersionInfo
                                    int64 m_Save;
                                    string_t m_Build;
                                    string_t m_PerforceStream;
                                } Savegame__VersionInfo;
                                break;

                            case 4:
                                struct { // Savegame::VersionId
                                    int32 m_Id;
                                    string_t m_Name;
                                } Savegame__VersionId;
                                break;

                            case 5:
                                struct { // Savegame::DateTime
                                    int32 m_Year;
                                    int32 m_Month;
                                    int32 m_Day;
                                    int32 m_DayOfWeek;
                                    int32 m_Hour;
                                    int32 m_Minute;
                                    int32 m_Second;
                                    int32 m_Milliseconds;
                                } Savegame__DateTime;
                                break;

                            case 6:
                                struct { // Savegame::SpawnSpot
                                    int32 c;
                                    string_t m_SpotType;
                                    string_t m_MapName;
                                    int16 m_MapArea;
                                    string_t m_SpawnPoint;
                                    vector3_t m_Pos;
                                    vector3_t m_Dir;
                                } Savegame__SpawnSpot;
                                break;

                            case 7:
                                struct { // Story::Savegame::Info
                                    struct {
                                        int32 count;
                                        int64 items[count];
                                    } m_Campaigns;
                                    int64 m_QuestId;
                                    int64 m_QuestCampaignId;
                                    int32 m_QuestDlc;
                                    struct {
                                        int32 count;
                                        int64 items[count];
                                    } m_Objectives;
                                    int32 m_Chapter;
                                } Story__Savegame__Info;
                                break;

                            default:
                                FSkip(header.size - 16);
                                break;
                        }
                    } item;
                }
            } chunk3_data;
        } blob;
    } blob;
};

struct elements_t {
    int32 count;
    int32 types[count];
    local int32 i;
    for (i = 0; i < count; ++i) {
        element_blob_header_t header;
        struct {
            int32 element_type;
            switch (element_type) {
                case ET_CLASS:
                    class_element_t class;
                    break;
                case 0x23:
                    struct {
                        int32 a;
                    } Savegame__Inventory__State;
                    break;
            }
        } element;
        FSeek(header.offset + header.size);
    }
//Assert(element.chunk.element_type == types[i]);
};

struct elements_blob_t {
    blob_header_t blob_header;
    elements_t elements;
};

struct file_t {
    int32 a;
    int32 b;
    int32 c;
    int32 version;
    
    string_t d;
    string_t e;
    int32 f;
    
    //blob_header_t state_elements_blob_header;
    //FSeek(state_elements_blob_header.offset);
    //state_elements_t data;
    
    elements_blob_t elements_blob;
};


file_t file;
