struct element_t {
    byte a;
    if (a) {
        uint32 size;
        union {
            byte raw[size];
            struct {
                /*data_chunk_header_t rtti_data_chunk_header;
                Assert(rtti_data_chunk_header.magic == 0x44444753); // SGDD
                uint32 magic;
                Assert(magic == 0x64444753); // SGDd
                rtti_info_t rtti_info;*/
                int32 a;
                Assert(a == 0x44444753); // SGDD
                int32 b;
                int64 c;
        
                int32 d_size;
                union {
                    byte raw[d_size];
                    struct {
                        local uint32 count = 0;
                        local uint64 start = FTell();
                        while (FTell() < start + d_size) {
                            struct {
                                uint32 magic;
                                Assert(magic == 0x64444753); // SGDd
                                int32 a;
                                int32 b_size;
                                union {
                                    byte raw[b_size];
                                    rtti_info_t rtti_info;
                                } b_data;
                                ++count;
                            } item;
                        }
                    } items;
                } d_data;
        
                int32 e;
                Assert(e == 0x6D444753); // SGDm
                int32 f;
                int32 g; // maybe this is the size of the data below (8 bytes fits nicely)
                int64 h; // maybe 2 x int32
        
                int32 i;
                Assert(i == 0x53444753); // SGDS
                int32 j;
                int64 k;
        
                int32 l_size;
                union {
                    byte raw[l_size];
                    struct {
                        local uint32 count = 0;
                        local uint64 start = FTell();
                        while (FTell() < start + l_size) {
                            struct {
                                uint32 magic;
                                Assert(magic == 0x73444753); // SGDs
                                int32 a;
                                int32 b_size;
                                union {
                                    byte raw[b_size];
                                    struct {
                                        rtt_pointer_t id;
                                        uint64 data_index;
                                        local string class_name = "";
                                        local uint32 class_index = 0;
                                        local uint64 rtti_index = 0;
                                        local uint32 field_index = 0;
                                        local uint32 type = 0;
                                        local string type_string = "";
                                        local string value_string = "";
                                        local string name = "";
                                        local int value_element_index = 0;
                                        local byte enable_dump = 1;
                                        for (class_index = 0; class_index < d_data.items.count; ++class_index) {
                                             rtti_index = d_data.items.item[class_index].b_data.rtti_info.index;
                                            if (data_index == rtti_index) {
                                                class_name = read_string_t(d_data.items.item[class_index].b_data.rtti_info.class_name);
                                                /*if (Strcmp(class_name, "Savegame::PersistentStorage::CampaignState") == 0) {
                                                    int32 m_DataFormat;
                                                    byte_vector_t m_DataDescription;
                                                    byte_vector_t m_Data;
                                                    byte_vector_t m_DataPresence;
                                                    uint64 m_Hash;
                                                    uint32 m_EmbeddedElements_count; // ?
                                                    //uint32 m_EmbeddedElements_items[m_EmbeddedElements_count];
                                                    int32 m_GameType;
                                                    int32 m_MapId;
                                                }*/
                                                /*if (Strcmp(class_name, "Skills::SkillInstance") == 0) {
                                                    string_t m_NameId;
                                                    int16 m_SkillLevel;
                                                    int16 m_SkillSlot;
                                                    int32_string_pair_t m_LearnMethod;
                                                }*/
                                                /*if (Strcmp(class_name, "Savegame::ProgressionState") == 0) {
                                                    pointer_vector_t m_Buckets;
                                                    uint64_vector_t m_QuestRewardsWithLegend;
                                                    int16_vector_t m_LegendRewardReceivedUids;
                                                    byte m_IsLegendLevelFromServer;
                                                    byte m_LastServerInfo;
                                                    byte m_LLResetAllowed;
                                                    int32 m_LLResetCounter;
                                                    uint64_vector_t m_EmbeddedElements;
                                                    int32 m_GameType;
                                                    int32 m_MapId;
                                                    break;
                                                }*/
                                                if (Strcmp(class_name, "Savegame::Difficulty::Trigger") == 0) {
                                                    int32_string_pair_t m_Trigger;
                                                    int32 m_EventInstances;
                                                    Assert(m_EventInstances == 0, Str("TODO: member %s of class %s", "m_EventInstances", class_name));
                                                    int32 m_EventCount;
                                                    float m_EventTime;
                                                    int32 m_EffectCount;
                                                    float m_EffectTimeLeft;
                                                    break;
                                                }
                                                if (Strcmp(class_name, "Savegame::Looting::ContainerId") == 0) {
                                                    uint64 m_Guid;
                                                    int32 m_CPath;
                                                    Assert(m_CPath == 0, Str("TODO: member %s of class %s", "m_CPath", class_name));
                                                    string_t m_Path;
                                                    break;
                                                }
                                                if (Strcmp(class_name, "Savegame::Challenges::Challenge") == 0) {
                                                    uint32 m_Id;
                                                    uint32 m_BestResult;
                                                    uint32 m_PrevBestResult;
                                                    uint32 m_LastResult;
                                                    float m_TimeTrialBestResult;
                                                    float m_TimeTrialLastResult;
                                                    byte m_UnderTheFog;
                                                    byte m_Active;
                                                    byte m_Completed;
                                                    byte m_UnlockInfoShown;
                                                    int32 m_TriggersData;
                                                    Assert(m_TriggersData == 0, Str("TODO: member %s of class %s", "m_TriggersData", class_name));
                                                    break;
                                                }
                                                /*if (Strcmp(class_name, "Savegame::Roaming::FovMapTiles") == 0) {
                                                    int32 m_Id;
                                                    uint32 m_Tiles;
                                                    uint32 m_Data_c;
                                                    uint32 m_Data_d[m_Data_c];
                                                    break;
                                                }*/
                                                if (enable_dump) {
                                                    Printf("Class: %s [id = %u]\n", class_name, id);
                                                    Printf("  Fields:\n");
                                                }
                                                for (field_index = 0; field_index < d_data.items.item[class_index].b_data.rtti_info.fields.count; ++field_index) {
                                                    type = d_data.items.item[class_index].b_data.rtti_info.fields.fields[field_index].type;
                                                    name = read_string_t(d_data.items.item[class_index].b_data.rtti_info.fields.fields[field_index].name);
                                                    switch (type) {
                                                        case RTTI_DATA_TYPE_INT8:
                                                            type_string = "int8";
                                                            char value <name="value">;
                                                            SPrintf(value_string, "%d", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_INT16:
                                                            type_string = "int16";
                                                            int16 value <name="value">;
                                                            SPrintf(value_string, "%d", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_INT32:
                                                            type_string = "int32";
                                                            int32 value <name="value">;
                                                            SPrintf(value_string, "%d", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_UINT32:
                                                            type_string = "uint32";
                                                            uint32 value <name="value">;
                                                            SPrintf(value_string, "%u", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_UINT64:
                                                        case RTTI_DATA_TYPE_U008:
                                                            type_string = "uint64";
                                                            uint64 value <name="value">;
                                                            SPrintf(value_string, "%lu", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_FLOAT:
                                                            type_string = "float";
                                                            float value <name="value">;
                                                            SPrintf(value_string, "%f", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_BOOL:
                                                            type_string = "bool";
                                                            byte value <name="value">;
                                                            SPrintf(value_string, "%s", value ? "true" : "false");
                                                            break;
                                                        case RTTI_DATA_TYPE_STRING:
                                                            type_string = "string";
                                                            string_t value <name="value">;
                                                            SPrintf(value_string, "\"%s\"", read_string_t(value));
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR3:
                                                            type_string = "vector3";
                                                            vector3_t value <name="value">;
                                                            SPrintf(value_string, "%f, %f, %f", value.x, value.y, value.z);
                                                            break;
                                                        case RTTI_DATA_TYPE_INT32_STRING_PAIR:
                                                            type_string = "pair<int32, string>";
                                                            int32_string_pair_t value <name="value">;
                                                            SPrintf(value_string, "%d, \"%s\"", value.first, read_string_t(value.second));
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_UINT64_25:
                                                            type_string = "vector<uint64>";
                                                            uint64_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u]", value.length);
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_STRING:
                                                            type_string = "vector<string>";
                                                            string_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u]", value.length);
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_BYTE:
                                                        case RTTI_DATA_TYPE_U0039:
                                                            type_string = "vector<byte>";
                                                            byte_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u]", value.length);
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_INT32:
                                                        case RTTI_DATA_TYPE_U0044:
                                                            type_string = "vector<int32>";
                                                            int32_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u]", value.length);
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_POINTER:
                                                        case RTTI_DATA_TYPE_VECTOR_OF_POINTER_86:
                                                            type_string = "vector<pointer>";
                                                            pointer_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u] {\n", value.length);
                                                            for (value_element_index = 0; value_element_index < value.length; ++value_element_index) {
                                                                Strcat(value_string, Str("        %u\n", value.elements[value_element_index]));
                                                            }
                                                            Strcat(value_string, "      }");
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_INT16:
                                                            type_string = "vector<int16>";
                                                            int16_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u]", value.length);
                                                            break;
                                                        case RTTI_DATA_TYPE_VECTOR_OF_UINT64:
                                                            type_string = "vector<uint64>";
                                                            uint64_vector_t value <name="value">;
                                                            SPrintf(value_string, "[count = %u]", value.length);
                                                            break;
                                                        case RTTI_DATA_TYPE_POINTER:
                                                            type_string = "pointer";
                                                            rtt_pointer_t value <name="value">;
                                                            SPrintf(value_string, "%u", value);
                                                            break;
                                                        default:
                                                            //type_string = "unknown";
                                                            //value_string = "[unknown]";
                                                            Assert(0, Str("Unknown type %u of %s::{%s}", type, class_name, name));
                                                            break;
                                                    }
                                                    if (enable_dump) {
                                                        Printf("    Field #%d:\n", field_index);
                                                        Printf("      Name: %s\n", name);
                                                        Printf("      Type: %s (%u)\n", type_string, type);
                                                        Printf("      Value: %s\n", value_string);
                                                    }

                                                    /*switch (d_data.items.item[class_index].b_data.rtti_info.fields.fields[field_index].type) {
                                                        case RTTI_DATA_TYPE_BOOL:
                                                            byte value;
                                                            Printf("%s", value ? "true" : "false");
                                                            break;
                                                        case RTTI_DATA_TYPE_INT32:
                                                            int32 value;
                                                            Printf("%d", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_INT64:
                                                            int64 value;
                                                            Printf("%ld", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_FLOAT:
                                                            float value;
                                                            Printf("%f", value);
                                                            break;
                                                        case RTTI_DATA_TYPE_STRING_12:
                                                        case RTTI_DATA_TYPE_STRING_20:
                                                            string_t value;
                                                            Printf(read_string_t(value));
                                                            break;
                                                        default:
                                                            Assert(0, "Unknown type");
                                                    }
                                                    Printf("\n");*/
                                                }
