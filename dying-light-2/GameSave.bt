typedef struct {
    uint16 length;
    if (length > 0) {
        char data[length];
    }
} string_t <read=read_string_t>;

string read_string_t(string_t& s) {
    return s.length > 0 ? s.data : "";
};

typedef struct {
    string_t key;
    uint16 value;
} uint16_dictionary_entry_t <read=read_uint16_dictionary_entry_t>;

string read_uint16_dictionary_entry_t(uint16_dictionary_entry_t& entry) {
    return read_string_t(entry.key);
};

struct uint16_dictionary_t {
    uint32 length;
    if (length > 0) {
        uint16_dictionary_entry_t entries[length] <optimize=false>;
    }
};

struct string_vector_t {
    uint32 length;
    if (length > 0) {
        string_t entries[length] <optimize=false>;
    }
};

struct blob_t {
    uint32 length;
    if (length > 0) {
        byte data[length];
    }
};

struct blob_entry_t {
    int32 a;
    blob_t b;
};

