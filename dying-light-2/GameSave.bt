struct elements_t {
    int32 count;
    int32 types[count];
    local int32 i;
    for (i = 0; i < count; ++i) {
        struct {
            //element_blob_header_t header;
            // a and size are read by LoadISGChunk
            int32 a; // bitset?
            int32 size;

            local uint64 data_offset = FTell();
            union {
                byte raw[size];
                struct {
                    /*int32 element_type;
                    switch (element_type) {
                        case ET_CLASS:
                            class_element_t class;
                            break;
                        case 0x23:
                            struct {
                                int32 a;
                            } Savegame__Inventory__State;
                            break;
                    }*/
                    int32 a; // value can be found in the types array
                    struct {
                        int32 version;
                        string_t version_rtti_name;
                        int32 a;
                        //Assert(a == 0 || a == 1); // Can it ever be anything else?
                        blob_header_t blob_header;
                        union {
                            byte raw[blob_header.size];
                            element_t element;
                        } data;
                        int32 b;
                        int32 c;
                        byte d[c];
                    } b;
                } inner_data;
            } data;
            /*int32 element_type;
            switch (element_type) {
                case ET_CLASS:
                    class_element_t class;
                    break;
                case 0x23:
                    struct {
                        int32 a;
                    } Savegame__Inventory__State;
                    break;
            }*/
        } sg_chunks;
        //FSeek(header.offset + header.size);
    }
//Assert(element.chunk.element_type == types[i]);
};

struct elements_blob_t {
    blob_header_t blob_header;
    elements_t elements;
};

struct file_t {
    struct {
        int32 a;
        int32 b;
        int32 c;
        int32 game_version;
        string_t game_version_rtti_name;
    } a;

    string_t d;
    int32 e;
    
    //blob_header_t state_elements_blob_header;
    //FSeek(state_elements_blob_header.offset);
    //state_elements_t data;
    
    elements_blob_t elements_blob;
};


file_t file;
