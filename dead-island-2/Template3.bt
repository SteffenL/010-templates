typedef struct {
    int32 length;
    if (length > 0) {
        char data[length] <optimize=false>;
    } /*else if (length < 0) {
        wchar_t data[-length] <optimize=false>;
    }*/
} String <read=ReadString_>;

// FNameEntrySerialized also has some hash stuff at the end

string ReadString_(String& from) {
    local string to;
    if (from.length > 0) {
        Strncpy(to, from.data, from.length);
    } else {
        to = "";
    }
    return to;
}

typedef struct {
    uint32 length;
    if (length > 0) {
        byte data[length] <optimize=false>;
    }
} Data;

struct Guid {
    byte data[16];
};

// Engine/Source/Runtime/CoreUObject/Public/UObject/PropertyTag.h
// Engine/Source/Runtime/CoreUObject/Private/UObject/PropertyTag.cpp
struct PropertyTag {
    String name;
    local string name_str = ReadString_(name);
    if (name_str == "None") {
        return;
    }
    String type;
    int32 size;
    /*if (size == 0) {
        return;
    }*/
    int32 array_index;
    local string type_str = ReadString_(type);

    // present if Tag.Type.GetNumber() == 0
    if (type_str == "StructProperty") {
        String struct_name;
        // struct_guid is present if Version >= VER_UE4_STRUCT_GUID_IN_PROPERTY_TAG
        Guid struct_guid;
    } else if (type_str == "BoolProperty") {
        byte bool_val;
    } else if (type_str == "ByteProperty" || type_str == "EnumProperty") {
        String enum_name;
    } else if (type_str == "ArrayProperty") {
        // present if Version >= VAR_UE4_ARRAY_PROPERTY_INNER_TAGS
        String inner_type;
    } else {
        // present if Version >= VER_UE4_PROPERTY_TAG_SET_MAP_SUPPORT
        if (type_str == "SetProperty") {
            String inner_type;
        } else if (type_str == "MapProperty") {
            String inner_type;
            String value_type;
        }
    }

    // present if Version >= VER_UE4_PROPERTY_GUID_IN_PROPERTY_TAG
    byte has_property_guid;
    if (has_property_guid) {
        Guid property_guid;
    }
};

struct Property;
void read_properties_until_none() {
    while (true) {
        Property property;
        if (ReadString_(property.tag.name) == "None") {
            break;
        }
    }
}

struct UObject {
    // Script Properties
};

struct UField;
struct UField {
    UObject Super;
    UField Next;
};

struct UProperty {
    UField Super;
};

struct UStruct {
    UField Super;
};

struct UArrayProperty {
    UProperty Super;
	int32			ArrayDim;
	//EPropertyFlags	PropertyFlags;
	//int32			ElementSize;
	//uint16			RepIndex;
	//FName		RepNotifyFunc;
};

typedef struct Property_ {
    PropertyTag tag;
    local string name_str = ReadString_(tag.name);
    if (name_str == "None") {
        return;
    }
    if (tag.size == 0) {
        return;
    }
    local string type_str = ReadString_(tag.type);
    local int64 data_pos = FTell();
    byte raw_data[tag.size];
    FSeek(data_pos);
    if (type_str == "ArrayProperty") {
        local string inner_type_str = ReadString_(tag.inner_type);
        int32 count;
        if (inner_type_str == "StructProperty") {
            Property value;
        } else if (count > 0) {
            struct {
                if (inner_type_str == "StrProperty" || inner_type_str == "ObjectProperty" || inner_type_str == "NameProperty") {
                    String value;
                } else {
                    Assert(0, Str("[Property] Unhandled ArrayProperty inner type %s", inner_type_str));
                }
            } items[count] <optimize=false>;
        }
    } else if (type_str == "MapProperty") {
        local string inner_type_str = ReadString_(tag.inner_type);
        local string value_type_str = ReadString_(tag.value_type);

    } else if (type_str == "EnumProperty") {
        String value;
    } else if (type_str == "FloatProperty") {
        float value;
    } else if (type_str == "IntProperty") {
        int32 value;
    } else if (type_str == "StrProperty") {
        String value;
    } else {
        Printf("[Property] TODO: %s\n", type_str);
        //Assert(0);
    }
    FSeek(data_pos + tag.size);
} Property <name=(ReadString_(tag.name))>;

enum VariantType {
    VariantType_Empty = 0,
    VariantType_Ansichar = 1,
    VariantType_Bool = 2,
    VariantType_Box = 3,
    VariantType_BoxSphereBounds = 4,
    VariantType_ByteArray = 5,
    VariantType_Color = 6,
    VariantType_DateTime = 7,
    VariantType_Double = 8,
    VariantType_Enum = 9,
    VariantType_Float = 10,
    VariantType_Guid = 11,
    VariantType_Int8 = 12,
    VariantType_Int16 = 13,
    VariantType_Int32 = 14,
    VariantType_Int64 = 15,
    VariantType_IntRect = 16,
    VariantType_LinearColor = 17,
    VariantType_Matrix = 18,
    VariantType_Name = 19,
    VariantType_Plane = 20,
    VariantType_Quat = 21,
    VariantType_RandomStream = 22,
    VariantType_Rotator = 23,
    VariantType_String = 24,
    VariantType_Widechar = 25,
    VariantType_Timespan = 26,
    VariantType_Transform = 27,
    VariantType_TwoVectors = 28,
    VariantType_UInt8 = 29,
    VariantType_UInt16 = 30,
    VariantType_UInt32 = 31,
    VariantType_UInt64 = 32,
    VariantType_Vector = 33,
    VariantType_Vector2d = 34,
    VariantType_Vector4 = 35,
    VariantType_IntPoint = 36,
    VariantType_IntVector = 37,
    VariantType_NetworkGUID = 38,
    VariantType_Custom = 0x40,
};

struct Variant {
    VariantType type;
    Data value_bytes;
    local int64 pos = FTell();
    FSkip(-value_bytes.length);
    switch (type) {
        case VariantType_Bool:
            int32 value; // Why is this 4 bytes instead of 1 byte?
            break;
        case VariantType_String:
            String value;
            break;
        case VariantType_Float:
            float value;
            break;
        case VariantType_Int32:
            int32 value;
            break;
        default:
            Assert(0, Str("Unknown variant type %d", type));
            break;
    }
    FSeek(pos);
};

struct StringToVariantPairArray {
    uint32 count;
    if (count > 0) {
        struct {
            String first;
            Variant second;
        } items[count] <optimize=false, read=(ReadString_(first))>;
    }
};

struct StringToInt32PairArray {
    uint32 count;
    if (count > 0) {
        struct {
            String first;
            uint32 second;
        } items[count] <optimize=false, read=(ReadString_(first))>;
    }
};

struct U003_Item;
typedef struct U003_Item_ {
    String name;
    String script_name;
    uint32 u001;
    read_properties_until_none();
    uint32 u002;
    local string name_str = ReadString_(script_name);
    if (name_str == "/Script/DeadIsland.DIInventoryPersistentData") {
        struct {
            StringToInt32PairArray u001;
        } script_data;
    } else if (name_str == "/Script/KnowledgeBase.KnowledgeBasePersistentDataCollection") {
        struct {
            uint32 maybe_item_type;
            uint32 count;
            switch (maybe_item_type) {
                case 115:
                    struct {
                        String name;
                        uint32 u004;
                        uint32 u005;
                        uint32 u006;
                    } item_115[count] <optimize=false>;
                    break;
                default:
                    // Can't figure out what the structure is without inspecting the data so only fail if we have data
                    if (count > 0) {
                        Assert(0, Str("Unknown item type %u, script %s", maybe_item_type, name_str));
                    }
                    Printf("[U003_Item] TODO: Item type %u, script %s\n", maybe_item_type, name_str);
                    break;
            }
        } script_data;
    } else if (name_str == "/Script/AudioPlugin.ScopedDialogueKBFactPersistentDataCollection") {
        struct {
            // Probably count and we need to figure out the structure of the items
            uint32 u001;
            Assert(u001 == 0);
        } script_data;
    } else if (name_str == "/Script/DSFramework.GameAchievementsPersistentState") {
        struct {
            uint32 count;
            struct {
                String name;
                StringToInt32PairArray items;
            } items[count] <optimize=false>;
        } script_data;
    } else if (name_str == "/Script/DSFramework.OptionsHierarchyPersistentState") {
        struct {
            StringToVariantPairArray items;
        } script_data;
    } else if (name_str == "/Script/DeadIsland.CharacterProfileSummary") {
        struct {
            StringToVariantPairArray items;
        } script_data;
    } else {
        Printf("[U003_Item] TODO: Script %s\n", name_str);
    }
} U003_Item <read=(ReadString_(name))>;

struct U003;
typedef struct U003_ {
    String name;
    uint32 u001;
    uint32 count;
    if (count > 0) {
        U003_Item items[count] <read=(ReadString_(name)), optimize=false>;
    }
    if (u001 > 0) {
        U003 u002[u001] <read=(ReadString_(name)), optimize=false>;
    }
} U003 <read=(ReadString_(name))>;

struct U001 {
    uint32 count;
    if (count > 0) {
        struct {
            uint32 count;
            if (count > 0) {
                U003_Item items[count] <optimize=false>;
            }
        } u001;
        U003 items[count] <optimize=false>;
    }
};


uint32 u001;
uint32 count;

struct {
    String key;
    struct {
        String name;
        String type;
        uint32 u006;
        uint32 u007;
        uint16 u008;
        String u009;
    } value;
} items[count] <optimize=false>;
