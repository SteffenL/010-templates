struct file_header_t {
    // Appears to always be 0x100286 for PC saves, 0xFF5BF for PS4 saves.
    uint32 u001; // not affected by checksum
    // The value 0x3000A has been observed for PC and PS4 saves.
    uint32 version; // not affected by checksum
    // Appears to always be 0x510ED901.
    // Game fails to load save if this changes.
    // TODO: Affected by checksum?
    uint32 u002;
};


struct chunk_header_t {
    uint32 compressed_size; // not affected by checksum
    uint32 decompressed_size;
    byte compressed_data[compressed_size]; // not affected by checksum if compressed data is different but decompressed data is same
};

//char unknown1[12];
file_header_t hader;
uint32 compression_length;
char compression[compression_length] <optimize=false>; // not affected by checksum
while (ReadUInt() != 0x5A13FC42) {
    chunk_header_t chunk_header <optimize=false>;
}
// Appears to always be 0x5A13FC42.
uint32 unknown2; // not affected by checksum
char hash[8];
