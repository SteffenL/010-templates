struct CharacterProfileAccount {
    uint32 u001;
    uint32 u002;
    String u003;
    String u004;
    uint32 u005;
    struct { read_property(); } u007;
    //Property2 u007;
    //Property2 u009;
};

typedef struct {
    String name;
    Data raw;
    local int64 pos = FTell();
    FSkip(-raw.length);
    if (Strncmp("CharacterProfileAccount", name.data, name.length) == 0) {
        CharacterProfileAccount character_profile_account;
    } else if (Strncmp("Options", name.data, name.length) == 0) {
        Options options;
    } else if (Strncmp("Challenges", name.data, name.length) == 0) {
        Challenges challenges;
    }
    FSeek(pos);
} Root_Item <read=(ReadString_(name))>;

typedef struct {
    uint32 count;
    Root_Item items[count] <optimize=false>;
} Root;

Root root;




