typedef struct {
    String name;
    DataType type;
    Data value_bytes;
    local int64 pos = FTell();
    FSkip(-value_bytes.length);
    switch (type) {
        case DataType_Float:
            float value;
            break;
        case DataType_Int32:
            int32 value;
            break;
        case DataType_String:
            String value;
            break;
        default:
            Printf("[Options_Item] Unhandled data type: %d\n", type);
            break;
    }
    FSeek(pos);
} Options_Item;

typedef struct {
    uint32 u001;
    uint32 u002;
    String u003;
    uint32 u004;
    uint32 u005;
    String u006;
    String u007;
    uint32 u008;
    String u009;
    uint32 u010;
    uint32 item_count;
    Options_Item item[item_count] <optimize=false, read=(ReadString_(name))>;
} Options;

void read_property() {
    String name;
    String type;
    uint64 value_length;
    local string type_str = ReadString_(type);
    if (type_str == "ArrayProperty") {
        struct {
            String element_type;
            byte terminator; // ?
            uint32 count;
            local int32 i;
            for (i = 0; i < count; ++i) {
                struct {
                    read_property();
                } element;
            }
        } array_property;
    } else if (type_str == "StructProperty") {
    }
    //byte value[value_length];
    //String element_type;
    //byte u005;
    //byte value[value_length];
}

