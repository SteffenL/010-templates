typedef enum {
    //DataType_? = 2, // 4 bytes, might be int32
    DataType_Float = 10,
    DataType_Int32 = 14,
    DataType_String = 24,
} DataType;

typedef struct {
    uint32 length;
    if (length > 0) {
        char data[length] <optimize=false>;
    }
} String <read=ReadString_>;

string ReadString_(String& from) {
    local string to;
    if (from.length > 0) {
        Strncpy(to, from.data, from.length);
    } else {
        to = "";
    }
    return to;
}

typedef struct {
    uint32 length;
    if (length > 0) {
        byte data[length] <optimize=false>;
    }
} Data;

struct StructProperty;

struct Property (const String& element_type) {
    local string type = ReadString_(element_type);
    if (type == "NameProperty") {
        String value;
    } else if (type == "StructProperty") {
        //StructProperty value;
    }
};

typedef struct ArrayProperty_Container (const String& element_type) {
    uint32 count;
    Property element(element_type)[count] <optimize=false>;
};

typedef struct ArrayProperty {
    String property_type;
    uint32 elements_data_length;
    uint32 u105;
    String element_type;
    byte u107;
    local int64 pos = FTell();
    byte elements_data[elements_data_length];
    FSeek(pos);
    ArrayProperty_Container container(element_type);
    FSeek(pos + elements_data_length);
    String u108;
};

struct ActiveChallengeCollection {
    uint32 u100;
    uint32 count;
    struct {
        String u102;
        String u103;
        ArrayProperty u104;
    } elements[count] <optimize=false>;
};

struct StructProperty {
    String u043;
    uint32 u044_length;
    uint32 u045;
    String u046;
    byte u047_all_zeroes[17];
    local int64 pos = FTell();
    byte u044_data[u044_length];
    FSeek(pos);

    local string u046_str = ReadString_(u046);
    if (u046_str == "ActiveChallengeCollection") {
        ActiveChallengeCollection active_challenge_collection;
    }

    FSeek(pos + data_length);
    //String u112;
};

typedef struct {
    String name;
    DataType type;
    Data value_bytes;
    local int64 pos = FTell();
    FSkip(-value_bytes.length);
    switch (type) {
        case DataType_String:
            String value;
            break;
        case DataType_Float:
            float value;
            break;
        case DataType_Int32:
            int32 value;
            break;
    }
    FSeek(pos);
    FSeek(pos + data_length);
} Challenges_Item;

typedef struct PropertyData (String& type) {
    if (Strncmp("NameProperty", type.data, type.length) == 0) {
        String value;
    } else if (Strncmp("StructProperty", type.data, type.length) == 0) {
        StructProperty value;
        /*String type;
        uint32 data_length;
        uint32 u1;
        String u2;
        uint32 u3;
        uint32 u4;
        union {
            byte data[data_length] <optimize=false>;
            Proper
        };*/
        //String u5;
        //String u6;
        //uint32 u7;
    } else if (Strncmp("MapProperty", type.data, type.length) == 0) {
    } else {
        Printf("Unhandled property type: %s", ReadString_(type));
    }
};

typedef struct {
    String type;
    uint32 data_length;
    uint32 u001;
    String key_type;
    String value_type;
    byte u002;
    local int64 pos = FTell();
    byte data[data_length] <optimize=false>;
    FSeek(pos);
    PropertyData key(key_type);
    PropertyData value(value_type);
    FSeek(pos + data_length);
    String u011;
} MapProperty <read=(Str("%s<%s, %s>", ReadString_(type), ReadString_(key_type), ReadString_(value_type)))>;

