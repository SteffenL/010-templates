struct ArrayProperty (const string& inner_type) {
    uint32 count;
    if (inner_type == "StructProperty") {
        PropertyTag tag;
        local int64 value_start_pos = FTell();
        byte value_data[tag.size];
        FSeek(value_start_pos);
        Property items(tag)[count] <optimize=false>;
        FSeek(value_start_pos + tag.size);
    } else if (inner_type == "StrProperty") {
        StrProperty items[count] <optimize=false>;
    } else if (inner_type == "UInt32Property") {
        UInt32Property items[count] <optimize=false>;
    } else {
        Printf("Unhandled array property inner type: %s\n", inner_type);
        //Assert(0, Str("Unhandler array property inner type: %s", inner_type));
    }
};

struct SetProperty (const string& inner_type) {
    uint32 u001;
    uint32 count;
    if (inner_type == "StructProperty") {
        PropertyTag tag;
        Property items(tag)[count] <optimize=false>;
    } else if (inner_type == "StrProperty") {
        StrProperty items[count] <optimize=false>;
    } else if (inner_type == "UInt32Property") {
        UInt32Property items[count] <optimize=false>;
    } else if (inner_type == "EnumProperty") {
        EnumProperty items[count] <optimize=false>;
    } else {
        Assert(0, Str("Unhandled set property inner type: %s", inner_type));
    }
};

