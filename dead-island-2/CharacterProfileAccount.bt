typedef struct {
    String name;
    Data raw;
    local int64 pos = FTell();
    FSkip(-raw.length);
    local string name_str = ReadString_(name);
    if (name_str == "CharacterProfileAccount") {
        CharacterProfileAccount character_profile_account;
    } else if (name_str == "Options") {
        Options options;
    } else if (name_str == "Account") {
        Printf("[Root] TODO: %s\n", name_str);
    } else if (name_str == "Challenges") {
        Printf("[Root] TODO: %s\n", name_str);
    } else if (Strlen(name_str) == 32) {
        CharacterData character_data;
    } else {
        Assert(0, Str("[Root] Unknown item: %s", name_str));
    }
    FSeek(pos);
} Root_Item <read=(ReadString_(name))>;

typedef struct {
    uint32 count;
    Root_Item items[count] <optimize=false>;
} Root;

Root root;
