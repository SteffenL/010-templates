#ifndef MAIN
#define MAIN
#endif

#include "include/Types.bt"
#include "SgChunk101.bt"
#include "SgChunk102.bt"

struct FileHeader
{
    int32 u1;
    int32 u2;
    int32 u3;
    int32 Version;
    int32 u5;
};

struct SectionHeader
{
    uint32 Id;
    uint32 Size;
};

GameType identifyGameFromFileHeader()
{
    if (g_fileHeader.u1 == -1 &&
        g_fileHeader.u2  == 0 &&
        g_fileHeader.u3 >= 14 &&
        g_fileHeader.Version >= 66 &&
        g_fileHeader.u5 >= 20)
    {
        return GameType_DyingLight;
    }

    return GameType_Unknown;
}

FileHeader g_fileHeader;
local GameType g_gameType = identifyGameFromFileHeader();
Assert(g_gameType != GameType_Unknown);

while (!FEof()) {
    struct {
        SectionHeader header;
        switch (header.Id) {
        case 101:
            SgChunk101 data;
            break;
        case 102:
            SgChunk102 data;
            break;
        default:
            struct {
                byte data[header.Size];
            } section;
            break;
        }
    } section;
}
