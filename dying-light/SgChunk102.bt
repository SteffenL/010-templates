        struct entry {
            int32_t key;
            int32_t value;
        };

        int32_t count;
        entry entries[count] <optimize=false>;
    };

    static const SgObjectId ID = 2;

    SG_SERIALIZE_ID;
    /// Maps ammo ID to value
    SgAmmo_Map items;
};

