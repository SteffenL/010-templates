struct SgDaytime {
    static const SgObjectId ID = 27;

    SG_SERIALIZE_ID;
    // When time >= 1.0, a day has elapsed
    int32_t daysElapsed;
    // 0.0 or greater = 00:00 or later, 0.5 = 12:00, less than 1.0 = earlier than 00:00.
    // When the time becomes >=1.0, it resets back to 0.0.
    // Conversion to seconds: (24*60*60)*time
    float time;
    int32_t unknown001;
};

