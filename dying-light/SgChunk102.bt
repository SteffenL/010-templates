/**
 * Inventory slots track the order of inventory items.
 *
 * The number of items is the same as the number of items in the inventory.
 * If the position is -1 then the slot is available.
 * A slot can be available e.g. when the number of items is below capacity or when the item is equipped.
 * When an item is equipped then it is ordered in the quick slot list instead of the inventory slots list.
 * A position equal to or greater than 0 is the position at which it should be displayed in the UI.
 */
struct SgInventorySlots {
    static const SgObjectId ID = 40;

    SG_SERIALIZE_ID;
    int32_t count;
    int16_t slots[count];
};

