enum SgItemColor {
    White = 0,
    Green = 1,
    Blue = 2,
    Violet = 3,
    Orange = 4,
    Platinum = 5
};

struct SgInventoryItem {
    // This is stored as a 32-bit packed integer
    struct Attributes {
        int32_t packed;
        // 3 bits: color
        // 7 bits:
        // Always 1 for melee weapons, 0 for throwables?
        // Could be required level as with Dead Island.
        // Value can be different for firearms but changing it seems to make no difference.
        // Usage of remaining bits is unknown
    };

    int32_t id;
    String name;
    String craftPlan;
    int64_t unknown002;
    Attributes attributes;
    int32_t quantity;
    float condition;
    int32_t repairs;
    int32_t unknown004;
    int32_t ammoId;
    int32_t upgradeSocketCount;
    String upgradeSockets[upgradeSocketCount] <optimize=false>;
    bool unknown006;
    bool unknown007;
    int32_t unknown008;
    bool unknown009;
};

struct SgInventory {
    static const SgObjectId ID = 83;

    SG_SERIALIZE_ID;
    int32_t count;
    SgInventoryItem items[count] <optimize=false>;
};

