        // TODO: Make sure to test both cases properly
        if (ReadInt() == 7) {
            Stats_t Stats;
        }
        else {
            Stats2_t Stats2;
        }

        Appearances_t Appearances;
        RewardsCampaigns_t RewardsCampaigns;
        Quests2_t Quests;
