struct InventoryItem_t
{
    uint32 unknown000;
    String Name;
    String CraftPlanName;
    int64 unknown001;

    int32 AttributesRaw;
    // 3 bits: Color          = (AttributesRaw & 7)
    // 7 bits: Required level = (AttributesRaw >> 3) & 0x7f
    //
    int32 Quantity;
    float Condition;
    int32 UpgradeLevel;

    int32 unknown002;
    int32 unknown003;
    int32 UpgradeSocketsCount;

    if (UpgradeSocketsCount > 0) {
        String UpgradeSockets[UpgradeSocketsCount] <optimize=false>; // CraftPlan name or "None"
    }

    // if X is >= 2 then...
    bool unknown005;

    // if X is >= 3 then...
    bool unknown006;

    // if X is >= 4 then...
    int32 unknown007; // should be int32 but maybe it's dynamic
};

string InventoryItem_t_display(InventoryItem_t& item)
{
    return item.Name.Data;
}

