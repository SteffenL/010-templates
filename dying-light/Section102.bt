        InvasionGracePeriod_t InvasionGracePeriod;
        InvasionReminder_t InvasionReminder;
        DocketsInfo_t DocketsInfo;

        if (DocketsInfo.Count == 0) {
            RedeemedDocketsCnt_t RedeemedDocketsCnt;
        }

        StoredInventorySetup_t StoredInventorySetup;
        LootingPlatinumContainers_t LootingPlatinumContainers;
