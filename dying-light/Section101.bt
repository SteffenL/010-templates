#ifndef SECTION101_H
#define SECTION101_H

#include "include/Types.bt"

// Difficulty:
// 1: Story Mode
// 2: Normal
// 3: Hard
// 4: Nightmare

struct Section101_Difficulty1_t {
    int32 HeaderId;
    Assert(HeaderId == 12);
    int32 Difficulty;
};

struct Section101_Difficulty2_t {
    int32 HeaderId;
    Assert(HeaderId == 13);
    int32 Difficulty;
};

struct Section101_Stop_t
{
    int32 HeaderId;
    Assert(HeaderId == 1);
};

struct Section101_Unknown001
{
    int32 unknown004_03;
    Assert(unknown004_03 == 9);
    
    if (version >= 50) {
        bool unknown004_04;
    }

    int32 unknown004_05;

    if (version >= 49) {
        int32 unknown004_06;
        Assert(unknown004_06 == 14);
        int32 unknown004_07;
    }


    struct {
        uint32 Count;
        Assert(Count == 3);
        String Text[Count]<optimize=false>;
    } strings;

    int32 unknown006;
    Assert(unknown006 == 4);

    String playerClass;

    // The current playthrough count.
    // 0 = Regular game; >=1 = Game+
    // This counter is incremented when a new game is started.
    // Examples: 0 for the first playthrough.
    //           1 for the second playthrough.
    //           2 for the third playthrough.
    int32 playthroughNumber;

    int32 unknown007_2;
    int32 unknown007_3;

    if (version >= 30) {
        struct {
            int32 Count;
            struct {
                String unknown001;
                int32 unknown002;
            } items[7]<optimize=false>;
        } unknown008_02;
    } else {
        // Skill tree/Proficiency points (for display)
        // 0: ? (always 1?)
        // 1: Agility points
        // 2: Power points
        // 3: Survival points
        int32 SkillTreeOrProficiencyPoints[4];
    }


    int32 unknown008;
    Assert(unknown008 == 5);

    String activeQuest1;
    String activeQuestJournalText;

    int32 unknown008_004;
    int32 storyCompletion;
    int32 totalCompletion;
    int32 unknown011;
    Assert(unknown011 == 6);

    TimeSpan timePlayed;
    DateTime saveTime;
    int32 unknown012;

    int32 unknown013;
    Assert(unknown013 == 8);
    bool unknown014;
    int32 unknown015; // Seems to always be -1

    if (version >= 41) {
        int32 unknown016;
        Assert(unknown016 == 10);
        struct {
            int32 unknown001;
            int32 unknown002;
            int32 unknown003;
            int32 unknown004;
            int64 unknown005[16];
            int32 unknown006;
        } unknown016_01[2]<optimize=false>;
    }

    if (version >= 43) {
        int32 unknown016_02;
        Assert(unknown016_02 == 11);
        struct {
            int32 count;
            if (count > 0) {
                struct {
                    int32 unknown001;
                    int32 unknown002;
                    int32 unknown003;
                    bool unknown004;
                } items[count]<optimize=false>;
            }
        } unknown016_03;
    }

    if (version >= 44) {
        Section101_Difficulty1_t difficulty1;
    }

    if (version >= 45) {
        Section101_Difficulty2_t difficulty2;
    }

    int32 unknown016_08;
    Assert(unknown016_08 == 7);
    float unknown18[3];
    float unknown19[3];

    if (version >= 57) {
        int32 unknown19_01;
        Assert(unknown19_01 == 15);
        int32 unknown19_02;
        int32 unknown19_03;
    }

    if (version >= 58) {
        int32 unknown19_04;
        Assert(unknown19_04 == 15);
        int16 unknown19_05;
    }

    if (version >= 59) {
        int32 unknown19_06;
        Assert(unknown19_06 == 16);
        int32 unknown19_07;
    }
};

struct Section101
{
    uint32 totalDataSize;
    struct
    {
        int32 unknown001;
        Assert(unknown001 == 0);
        int32 unknown002;
        Assert(unknown002 == 2);

        // Note: This value matches the 4th int found in the file magic/header. Could be a coincidence though.
        int32 version; // Version?
        //Assert(unknown003 == g_fileHeader.u4);

        int32 unknown004_01;
        Assert(unknown004_01 == 1);

        // Index 0: Campaign data
        // Undex 1: The Following data
        int32 unknown004_02_count;
        if (unknown004_02_count > 0) {
            Section101_Unknown001 unknown004_02_items[unknown004_02_count]<optimize=false>;
        }

        if (version >= 51) {
            int32 unknown005;
            Assert(unknown005 == 3);
            int32 unknown006; // 0 for new campaign saves, 1 after starting The Following
        }

        Section101_Stop_t Stop;
    } data;
};

#ifndef MAIN
Section101 data;
#endif

#endif
