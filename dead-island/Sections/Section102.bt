#include "include/Types.bt"

struct InventoryItem_t
{
    String Name;
    String CraftPlanName;

    int32 AttributesRaw;
    // 3 bits: Color          = (AttributesRaw & 7)
    // 7 bits: Required level = (AttributesRaw >> 3) & 0x7f
    // 
    int32 Quantity;
    float Condition;
    int32 UpgradeLevel;
};

typedef InventoryItem_t InventoryItem <read=t_ReadInventoryItem>;

string t_ReadInventoryItem(InventoryItem& item)
{
    return item.Name.Data;
}

struct InventoryItemContainer
{
    int32 HeaderId;
    Assert(HeaderId == 1);
    int32 Count;
    if (Count > 0) {
        InventoryItem Items[Count] <optimize=false>;
    }
};

struct QuickSlots_t
